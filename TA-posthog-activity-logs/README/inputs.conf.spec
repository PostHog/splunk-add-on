[posthog_activity_logs://<name>]
posthog_host = <value> Region host, for example https://us.posthog.com or https://eu.posthog.com
organization_id = <value> Collects activity across every project in this organization
personal_api_key = <value> A PostHog personal API key with the activity_log:read scope
include_values = <value> Include the previous and new values of changed fields. Defaults to false.
start_date = <value> Optional ISO-8601 lower bound for the first run
